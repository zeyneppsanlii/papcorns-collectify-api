{
  "name": "collectify-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest test/unit",
    "test:integration": "firebase emulators:exec --only firestore,auth --project papcorns-collectify-api \"jest test/integration --runInBand\"",
    "test:integration:running": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=papcorns-collectify-api jest test/integration --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
